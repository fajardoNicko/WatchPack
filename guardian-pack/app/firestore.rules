rules_version = '2';

// WatchPack Firestore rules.
//
// Principle: a parent can only see devices listed in their own profile
// (users/{uid}.deviceIds). The device writes its own telemetry over the REST API with
// no account, proving itself with a per-device secret (see fromDevice). Backend jobs
// use the Admin SDK, which bypasses these rules.
//
// Deploy:  firebase deploy --only firestore:rules   (from app/)
// Note: tools/seed_demo.mjs writes unauthenticated and stops working once these
// are deployed — run it with the Admin SDK / a service account instead.

service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
    }

    function linkedTo(deviceId) {
      return signedIn() && (myProfile().deviceIds.hasAny([deviceId]));
    }

    // The device itself has no Firebase account. It proves who it is with its secret:
    // every write carries auth = "<secret>:<random>", and cmdbox/<secret> names the device.
    // The random part changes on each write, so an update that doesn't send a fresh auth
    // (i.e. anyone without the secret) never passes.
    function fromDevice(deviceId, data) {
      return data.auth is string
        && get(/databases/$(db)/documents/cmdbox/$(data.auth.split(':')[0])).data.deviceId == deviceId;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A parent's own profile. Linking a device = adding its id here.
    // TODO(step 3): require a link code via a Cloud Function so a device id alone isn't enough.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Earthquakes scraped by the backend — public safety data, readable by any parent.
    match /quakes/{quake} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Command mailbox the device polls ("Find device"). The doc id is the device's
    // secret, so knowing the id is the permission; it can't be listed.
    match /cmdbox/{secret} {
      allow get: if true;
      allow update: if changed().hasOnly(['buzz']);
      allow list, create, delete: if false;
    }

    // Device document + everything under it (locations, zones, alerts, settings).
    match /devices/{deviceId} {
      allow read: if linkedTo(deviceId);
      // Parents may change settings-type fields, never the telemetry the device writes.
      // The device may change only telemetry, with a fresh auth.
      allow update: if (linkedTo(deviceId)
          && changed().hasOnly(['name', 'buzz', 'contacts', 'school', 'photo']))
        || (changed().hasOnly(['lastLat', 'lastLng', 'lastSeen', 'battery', 'speedKmh', 'status',
                               'buzz', 'gpsFix', 'csq', 'sosAt', 'fw', 'auth'])
          && changed().hasAll(['auth'])
          && fromDevice(deviceId, request.resource.data));
      allow create, delete: if false;

      match /locations/{fix} {
        allow read: if linkedTo(deviceId);
        allow create: if fromDevice(deviceId, request.resource.data)
          && request.resource.data.keys().hasOnly(['lat', 'lng', 'spd', 'bat', 'ts', 'auth'])
          && request.resource.data.ts == request.time;
        allow update, delete: if false;
      }
      match /alerts/{alert} {
        allow read: if linkedTo(deviceId);
        allow write: if false;            // only backend jobs raise alerts
      }
      match /zones/{zone} {
        allow read, write: if linkedTo(deviceId);
      }
      match /settings/{doc} {
        allow read, write: if linkedTo(deviceId);
      }
    }
  }
}
