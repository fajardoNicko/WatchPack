rules_version = '2';

// WatchPack Firestore rules.
//
// Principle: a parent can only see devices listed in their own profile
// (users/{uid}.deviceIds). The device writes its own telemetry over the REST API with
// no account, proving itself with a per-device secret (see fromDevice). Backend jobs
// use the Admin SDK, which bypasses these rules.
//
// Deploy:  firebase deploy --only firestore:rules   (from app/)
// Note: tools/seed_demo.mjs writes unauthenticated and stops working once these
// are deployed — run it with the Admin SDK / a service account instead.

service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
    }

    function linkedTo(deviceId) {
      return signedIn() && (myProfile().deviceIds.hasAny([deviceId]));
    }

    // The device itself has no Firebase account. It proves who it is with its secret:
    // every write carries auth = "<secret>:<random>", and cmdbox/<secret> names the device.
    // The random part changes on each write, so an update that doesn't send a fresh auth
    // (i.e. anyone without the secret) never passes.
    function fromDevice(deviceId, data) {
      return data.auth is string
        && get(/databases/$(db)/documents/cmdbox/$(data.auth.split(':')[0])).data.deviceId == deviceId;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function linkCode(code) {
      return get(/databases/$(db)/documents/linkcodes/$(code)).data;
    }

    // Device ids this write adds to a profile.
    function addedDevices() {
      let before = resource == null ? [] : resource.data.get('deviceIds', []);
      return request.resource.data.get('deviceIds', []).toSet().difference(before.toSet());
    }

    // A profile only gains a device together with a valid code for exactly that device
    // (linkcodes/{code}, written as profile.linkCode). The shared demo device needs none.
    function linkAllowed() {
      let added = addedDevices();
      return added.size() == 0
        || added.hasOnly(['wp-demo-ivy'])
        || (request.resource.data.get('linkCode', null) is string
            && added == [linkCode(request.resource.data.linkCode).deviceId].toSet()
            && (linkCode(request.resource.data.linkCode).get('expiresAt', null) == null
                || linkCode(request.resource.data.linkCode).expiresAt > request.time));
    }

    // A parent's own profile. Linking a device = adding its id here, with a code.
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && linkAllowed();
    }

    // Pairing codes (kind 'device', made by provision.mjs, no expiry) and one-time
    // invites (kind 'invite') that a linked parent makes for another parent. The code is
    // the doc id: knowing it is the permission, so codes can't be listed by others.
    match /linkcodes/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.get('createdBy', null) == request.auth.uid;
      allow create: if linkedTo(request.resource.data.deviceId)
        && request.resource.data.keys().hasOnly(['deviceId', 'kind', 'createdBy', 'createdByName', 'expiresAt'])
        && request.resource.data.kind == 'invite'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(3, 'd');
      // The maker can cancel it; whoever used it retires it.
      allow delete: if signedIn() && resource.data.get('kind', null) == 'invite'
        && (resource.data.createdBy == request.auth.uid || linkedTo(resource.data.deviceId));
      allow update: if false;
    }

    // Earthquakes scraped by the backend — public safety data, readable by any parent.
    match /quakes/{quake} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Command mailbox the device polls ("Find device"). The doc id is the device's
    // secret, so knowing the id is the permission; it can't be listed.
    match /cmdbox/{secret} {
      allow get: if true;
      allow update: if changed().hasOnly(['buzz']);
      allow list, create, delete: if false;
    }

    // Device document + everything under it (locations, zones, alerts, settings).
    match /devices/{deviceId} {
      allow read: if linkedTo(deviceId);
      // Parents may change settings-type fields, never the telemetry the device writes.
      // The device may change only telemetry, with a fresh auth.
      allow update: if (linkedTo(deviceId)
          && changed().hasOnly(['name', 'buzz', 'contacts', 'school', 'photo']))
        || (changed().hasOnly(['lastLat', 'lastLng', 'lastSeen', 'battery', 'speedKmh', 'status',
                               'buzz', 'gpsFix', 'csq', 'sosAt', 'fw', 'auth'])
          && changed().hasAll(['auth'])
          && fromDevice(deviceId, request.resource.data));
      allow create, delete: if false;

      match /locations/{fix} {
        allow read: if linkedTo(deviceId);
        allow create: if fromDevice(deviceId, request.resource.data)
          && request.resource.data.keys().hasOnly(['lat', 'lng', 'spd', 'bat', 'ts', 'auth'])
          && request.resource.data.ts == request.time;
        allow update, delete: if false;
      }
      match /alerts/{alert} {
        allow read: if linkedTo(deviceId);
        allow write: if false;            // only backend jobs raise alerts
      }
      match /zones/{zone} {
        allow read, write: if linkedTo(deviceId);
      }
      match /settings/{doc} {
        allow read, write: if linkedTo(deviceId);
      }
      // Who can see this device. Each parent writes only their own entry. Not on the
      // demo device, which every account shares.
      match /members/{uid} {
        allow read: if linkedTo(deviceId);
        allow create, update: if request.auth.uid == uid && linkedTo(deviceId) && deviceId != 'wp-demo-ivy'
          && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'joinedAt']);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
